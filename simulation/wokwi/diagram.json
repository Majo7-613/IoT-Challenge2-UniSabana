{
  "version": 1,
  "author": "Equipo 7 - IoT Challenge #2",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-hc-sr04", "id": "nivel", "top": -160, "left": -180, "attrs": { "distance": "100" } },
    { "type": "wokwi-dht22", "id": "dht", "top": -150, "left": 160, "attrs": { "temperature": "18", "humidity": "70" } },
