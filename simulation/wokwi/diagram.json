    [ "lcd:VCC", "esp:5V", "red", [] ],
    [ "lcd:GND", "esp:GND.3", "black", [] ],
    [ "lcd:SDA", "esp:21", "blue", [] ],
    [ "lcd:SCL", "esp:22", "violet", [] ],

    [ "guva:VCC", "esp:3V3", "red", [] ],
    [ "guva:GND", "esp:GND.1", "black", [] ],
    [ "guva:SIG", "esp:34", "cyan", [] ],

    [ "buzzer:1", "esp:GND.2", "black", [] ],
