# Plantilla de configuración del gateway. Copiar como .env (en la misma carpeta) y llenar.
# .env está en .gitignore: las claves y el token nunca se suben al repositorio.

# Broker local (Mosquitto en la Raspberry Pi; en el computador de desarrollo, localhost).
MQTT_HOST=localhost
MQTT_PUERTO=1883
MQTT_USUARIO=gw-chia
MQTT_CLAVE=cambiar-esta-clave
MUNICIPIO=chia
NODO=chia-01

# Base de datos SQLite.
BD_RUTA=gateway.db

# Promedios hacia Ubidots (s) y latitud del sitio para la ET0.
PERIODO_AGREGADO_S=300
LATITUD_GRADOS=4.86

# Ubidots (cuenta STEM). Vacío = envío a la nube desactivado (los datos quedan en la cola).
# Servidor, puerto y tópicos: confirmar en la documentación de Ubidots al crear la cuenta.
UBIDOTS_TOKEN=
UBIDOTS_HOST=industrial.api.ubidots.com
UBIDOTS_PUERTO=8883
UBIDOTS_TLS=1
UBIDOTS_TOPICO_PUBLICAR=/v1.6/devices/{dispositivo}
UBIDOTS_TOPICO_ORDEN=/v1.6/devices/{dispositivo}/desactivar_alarma/lv
UBIDOTS_DISPOSITIVO_NODO=chia-01
UBIDOTS_DISPOSITIVO_GATEWAY=gw-chia

# Módulo de IA: recomendación en texto con la API de Gemini (vacío = texto de respaldo sin API).
GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.0-flash
